# Copy this file to `.env` and fill in real values. `.env` is gitignored.
# Anything you export in your shell overrides these.

# --- Required ---------------------------------------------------------------
# Groq API key that powers the screener/preparer agents (must support tools).
GROQ_API_KEY=gsk_your_key_here

# LinkedIn credentials used by the Selenium ingestion login.
LINKEDIN_EMAIL=you@example.com
LINKEDIN_PASSWORD=your_password_here

# --- Optional model overrides (defaults shown) ------------------------------
# OLLAMA_MODEL=qwen2.5:7b
# EMBEDDING_MODEL=all-MiniLM-L6-v2
# GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MAX_RETRIES=8
GROQ_REQUESTS_PER_SECOND=0.1

# --- Optional LangSmith tracing ---------------------------------------------
# Set LANGSMITH_TRACING=true to send agent traces to LangSmith.
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://apac.api.smith.langchain.com
LANGSMITH_API_KEY=lsv2_your_key_here
LANGSMITH_PROJECT="JobFit-AI"